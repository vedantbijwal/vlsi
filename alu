module alu_if_else(
    input [3:0] A, B,
    input [2:0] S,
    output reg [3:0] Y
);

always @(*)
begin

    if(S == 3'b000)
        Y = A + B;

    else if(S == 3'b001)
        Y = A - B;

    else if(S == 3'b010)
        Y = A & B;

    else if(S == 3'b011)
        Y = A | B;

    else if(S == 3'b100)
        Y = A ^ B;

    else if(S == 3'b101)
        Y = ~(A & B);

    else if(S == 3'b110)
        Y = ~(A | B);

    else if(S == 3'b111)
        Y = ~A;

    else
        Y = 4'b0000;

end

endmodule
