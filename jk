module jk_flip_flop (
    input wire clk,
    input wire rst_n,
    input wire j,
    input wire k,

    output reg q,
    output wire q_bar
);

reg [25:0] divider_counter;
reg clk_1hz;

always @(posedge clk or negedge rst_n)
begin

    if (!rst_n)
    begin
        divider_counter <= 26'd0;
        clk_1hz <= 1'b0;
    end

    else
    begin

        if (divider_counter == 26'd49_999_999)
        begin
            divider_counter <= 26'd0;
            clk_1hz <= ~clk_1hz;
        end

        else
        begin
            divider_counter <= divider_counter + 1'b1;
        end

    end

end

always @(posedge clk_1hz or negedge rst_n)
begin

    if (!rst_n)
    begin
        q <= 1'b0;
    end

    else
    begin

        case ({j,k})

            2'b00: q <= q;
            2'b01: q <= 1'b0;
            2'b10: q <= 1'b1;
            2'b11: q <= ~q;

        endcase

    end

end

assign q_bar = ~q;

endmodule
test
`timescale 1ns / 1ps

module tb_jk_flip_flop;

    // Declare inputs as reg
    reg clk;
    reg rst_n;
    reg j;
    reg k;

    // Declare outputs as wire
    wire q;
    wire q_bar;

    // Instantiate the JK Flip-Flop
    jk_flip_flop uut (
        .clk(clk),
        .rst_n(rst_n),
        .j(j),
        .k(k),
        .q(q),
        .q_bar(q_bar)
    );

    // Generate 10ns clock
    always #5 clk = ~clk;

    // Apply input conditions
    initial begin

        // Initial conditions
        clk = 0;
        rst_n = 0;
        j = 0;
        k = 0;

        // Release reset
        #12 rst_n = 1;

        // Test SET condition
        #10 j = 1; k = 0;

        // Test RESET condition
        #10 j = 0; k = 1;

        // Test TOGGLE condition
        #10 j = 1; k = 1;

        // Test HOLD condition
        #20 j = 0; k = 0;

        // Finish simulation
        #20 $finish;

    end

    // Monitor output
    initial begin
        $monitor("Time=%0t | CLK=%b | RST_N=%b | J=%b | K=%b | Q=%b | Q_BAR=%b",
                  $time, clk, rst_n, j, k, q, q_bar);
    end

endmodule
