module tb_mux4;

reg I0, I1, I2, I3;
reg S0, S1;

wire Y;

// DUT (Design Under Test)
mux4_behavioral DUT(
    I0, I1, I2, I3, S0, S1, Y
);

initial
begin

    $monitor("Time=%0t | S1=%b S0=%b | I0=%b I1=%b I2=%b I3=%b | Y=%b",
             $time, S1, S0, I0, I1, I2, I3, Y);

    I0 = 0; I1 = 1; I2 = 1; I3 = 0;

    S1 = 0; S0 = 0;
    #10;

    S1 = 0; S0 = 1;
    #10;

    S1 = 1; S0 = 0;
    #10;

    S1 = 1; S0 = 1;
    #10;

    $finish;

end

endmodule
