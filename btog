module binary_to_gray(
    input [3:0] B,
    output [3:0] G
);

assign G[3] = B[3];
assign G[2] = B[3] ^ B[2];
assign G[1] = B[2] ^ B[1];
assign G[0] = B[1] ^ B[0];

endmodule
test
module tb_binary_to_gray;

reg [3:0] B;
wire [3:0] G;

binary_to_gray uut(B, G);

initial
begin
