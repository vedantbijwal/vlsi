module SISO (
    input wire clk,
    input wire reset,
    input wire s_in,
    output wire s_out
);

reg clk_1hz;
reg [25:0] counter;

reg q0, q1, q2, q3;

// Frequency Divider
always @(posedge clk or negedge reset)
begin
    if (!reset)
    begin
        counter <= 26'd0;
        clk_1hz <= 1'b0;
    end

    else
    begin
        if (counter == 26'd49_999_999)
        begin
            counter <= 26'd0;
            clk_1hz <= ~clk_1hz;
        end

        else
        begin
            counter <= counter + 1'b1;
        end
    end
end

// SISO Shift Register
always @(posedge clk_1hz or negedge reset)
begin
    if (!reset)
    begin
        q0 <= 1'b0;
        q1 <= 1'b0;
        q2 <= 1'b0;
        q3 <= 1'b0;
    end

    else
    begin
        q0 <= s_in;
        q1 <= q0;
        q2 <= q1;
        q3 <= q2;
    end
end

assign s_out = q3;

endmodule
test bench
module siso_tb;

reg clk;
reg rst;
reg serial_in;

wire serial_out;

siso uut(
    .clk(clk),
    .rst(rst),
    .serial_in(serial_in),
    .serial_out(serial_out)
);

// Clock generation
initial
begin
    clk = 0;
    forever #5 clk = ~clk;
end

// Input stimulus
initial
begin
    rst = 1;
    serial_in = 0;

    #10;
    rst = 0;

    serial_in = 1; #10;
    serial_in = 0; #10;
    serial_in = 1; #10;
    serial_in = 1; #10;

    #30;
    $finish;
end

// Monitor
initial
begin
    $monitor("Time=%0t | Reset=%b | Input=%b | Register=%b | Output=%b",
             $time, rst, serial_in, uut.shift_reg, serial_out);
end

endmodule
