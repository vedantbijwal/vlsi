module HA(
    input a, b,
    output sum,
    output carry
);

assign sum = a ^ b;
assign carry = a & b;

endmodule
module OR_GATE(
    input a, b,
    output Cout
);

assign Cout = a | b;

endmodule
module FA(
    input a, b, Cin,
    output sum,
    output Cout
);

wire w1, w2, w3;

// First Half Adder
HA HA_1(a, b, w1, w2);

// Second Half Adder
HA HA_2(w1, Cin, sum, w3);

// OR Gate
OR_GATE OR_1(w2, w3, Cout);

endmodule
